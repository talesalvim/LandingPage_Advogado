---
import { Image } from 'astro:assets'
import photo from '../assets/photo-advogado.jpg'
import { siteConfig } from '../data/site'
---

<section class="relative min-h-screen flex items-center pt-16 lg:pt-20 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black pointer-events-none" />
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="flex justify-center lg:justify-end order-1">
        <div class="relative">
          <div class="w-64 h-64 sm:w-72 sm:h-72 lg:w-96 lg:h-96 rounded-full overflow-hidden ring-2 ring-gold/30 ring-offset-4 ring-offset-black">
            <Image
              src={photo}
              alt="Dr. Douglas Genelhu Guilherme — Advogado especialista em planejamento sucessório e societário"
              class="w-full h-full object-cover"
              width={853}
              height={1280}
            />
          </div>
          <div class="absolute -bottom-4 -right-4 w-24 h-24 border border-gold/20 rounded-full" aria-hidden="true" />
          <div class="absolute -top-4 -left-4 w-16 h-16 border border-gold/10 rounded-full" aria-hidden="true" />
        </div>
      </div>
      <div class="text-center lg:text-left order-2">
        <span class="inline-block text-gold text-sm font-medium tracking-widest uppercase mb-6">
          {siteConfig.oab}
        </span>
        <p class="text-gold text-2xl font-medium tracking-wide mb-2 font-serif leading-tight">
          Quem planeja, Preserva!
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-serif leading-tight">
          Serviço Jurídico<br />
          <span class="text-gold">Especializado</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-gray-400 leading-relaxed max-w-xl lg:max-w-none">
          Assessoria dedicada em planejamento sucessório e societário, conduzida com ética,
          transparência e respeito à história de cada família e empresa.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 lg:justify-start">
          <a
            href="#agendamento"
            class="inline-flex items-center gap-3 px-8 py-4 bg-gold text-black font-medium text-base rounded-lg hover:bg-gold/90 transition-all duration-300"
          >
            Agendar Reunião
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="#sobre"
            class="inline-flex items-center gap-2 px-8 py-4 text-gray-300 font-medium text-base border border-gray-800 rounded-lg hover:border-gold/50 hover:text-gold transition-all duration-300"
          >
            Conheça mais
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
