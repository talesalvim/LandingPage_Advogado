---
import { UserCheck, Briefcase, Shield, PenTool } from '@lucide/astro'
import { differentials } from '../data/differentials'

const iconMap: Record<string, any> = {
  UserCheck,
  Briefcase,
  Shield,
  PenTool,
}
---

<section id="diferenciais" class="scroll-mt-16 lg:scroll-mt-20 py-20 lg:py-32 bg-gray-900/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="mt-4 text-3xl lg:text-4xl font-serif">Diferenciais</h2>
      <div class="mx-auto mt-4 w-16 h-0.5 bg-gold/60" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {
        differentials.map((item) => {
          const Icon = iconMap[item.icon]
          return (
            <div class="group p-6 lg:p-8 rounded-xl border border-gray-800 bg-black hover:border-gold/40 hover:-translate-y-1 transition-all duration-300 text-center">
              {Icon && (
                <div class="mx-auto mb-5 w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center group-hover:bg-gold/20 transition-colors duration-300">
                  <Icon class="w-6 h-6 text-gold" />
                </div>
              )}
              <h3 class="text-lg font-serif text-white mb-3">{item.title}</h3>
              <p class="text-gray-400 leading-relaxed text-sm">{item.description}</p>
            </div>
          )
        })
      }
    </div>
  </div>
</section>
